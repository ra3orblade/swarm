{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm",
  "version": "0.1.0",
  "identifier": "com.ra3orblade.swarm",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Swarm",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/swarmd"],
    "resources": ["web/*"]
  }
}
