{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Swarm desktop capabilities",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "shell:allow-execute",
    "shell:allow-open",
    "updater:default"
  ]
}
