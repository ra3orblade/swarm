{
  "name": "swarm-monorepo",
  "private": true,
  "version": "0.5.0",
  "description": "Local-first control plane for AI-agent development: watch every Claude Code session, ledger tasks/worktrees/resources, enforce rules.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ra3orblade/swarm.git"
  },
  "bugs": {
    "url": "https://github.com/ra3orblade/swarm/issues"
  },
  "homepage": "https://github.com/ra3orblade/swarm#readme",
  "keywords": [
    "claude-code",
    "ai-agents",
    "observability",
    "orchestration",
    "worktrees",
    "developer-tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "swarm": "bun packages/cli/src/bin.ts",
    "setup": "bun packages/cli/src/bin.ts setup",
    "dev": "bun run --filter @swarm/daemon dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "smoke": "bun tools/smoke.ts",
    "docs:check": "bun tools/docs-check.ts",
    "site:build": "bun tools/build-site.ts",
    "site:deploy": "vercel deploy --prod",
    "postinstall": "bun run --filter @swarm/web build",
    "build:web": "bun run --filter @swarm/web build",
    "desktop:prep": "bun tools/desktop.ts",
    "desktop:dev": "bun tools/desktop.ts && cd apps/desktop/src-tauri && cargo run",
    "desktop:build": "bun tools/desktop.ts --bundle",
    "build:pkg": "bun tools/build-pkg.ts",
    "version:set": "bun tools/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "latest",
    "marked": "^18.0.10",
    "typescript": "^5.9.2"
  }
}
