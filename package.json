{
  "name": "harness-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first control plane for AI-agent development: watch every Claude Code session, ledger tasks/worktrees/resources, enforce rules.",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/harness.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/harness/issues"
  },
  "homepage": "https://github.com/OWNER/harness#readme",
  "keywords": [
    "claude-code",
    "ai-agents",
    "observability",
    "orchestration",
    "worktrees",
    "developer-tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "harness": "bun packages/cli/src/bin.ts",
    "setup": "bun packages/cli/src/bin.ts setup",
    "dev": "bun run --filter @harness/daemon dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "smoke": "bun tools/smoke.ts",
    "docs:check": "bun tools/docs-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
